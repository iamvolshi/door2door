# =========================================================================
# Cox's Bazar Hyperlocal Delivery Platform - Environment Configuration
# =========================================================================
#
# src/config/env.ts is the authority on what the runtime reads, and
# `assertSecureProductionConfig` refuses to start in production while a development
# default or a missing SMS credential is still in place. Keys marked RESERVED below are
# roadmap configuration: documented here, read by nothing yet, so changing them has no
# effect today.

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME="Cox's Bazar Express"
APP_URL=http://localhost:4000
API_BASE_PATH=/api/v1

# -------------------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------------------
# Which engine stores the data. 'sqlite' (the default) opens the one file below, in WAL
# mode, shared by every process on the host. 'postgres' runs against a server, which is
# what several hosts or a scheduler that moves processes requires — see item 8 of
# docs/LIMITATIONS_AND_ROADMAP.md for what each one guarantees.
DB_DRIVER=sqlite

# The SQLite file, used when DB_DRIVER=sqlite.
SQLITE_STORAGE_PATH=./data/cxb_delivery.sqlite

# The PostgreSQL server, used when DB_DRIVER=postgres. The schema is created and migrated by
# the API on boot, so there is no separate migration step to run. A connection string carries
# the password: keep it out of logs and out of version control, and the boot log prints only
# the host, port and database it resolved to.
# DATABASE_URL=postgresql://cxb_admin:your_secure_password@localhost:5432/cxb_delivery_db
# Connections held open. Writers serialise (the platform's invariants were written against
# SQLite's single write lock, and the PostgreSQL driver keeps that guarantee), so this bounds
# concurrent reads — the traffic that scales.
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=10000

# --- RESERVED (not read by the runtime) ---
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cxb_delivery_db
DB_USER=cxb_admin
DB_PASSWORD=supersecretpassword
DB_SSL=false

# -------------------------------------------------------------------------
# Authentication & JWT Security
# -------------------------------------------------------------------------
# One signing secret, minimum 16 characters. The development default is refused at boot
# in production, so a deployment must set a real value here.
JWT_SECRET=your_jwt_signing_secret_minimum_16_chars
# Keys the hashes of login codes at rest, so a stolen database file or backup cannot be
# matched offline against a guessed six-digit code. Also refused at boot on its default.
ENCRYPTION_KEY=your_encryption_key_at_least_32_characters
# Access and refresh lifetimes are fixed in code (15 minutes, 7 days) and reported back as
# `expiresIn` on every login, so nothing has to be configured for them.

# --- RESERVED (not read by the runtime) ---
JWT_ACCESS_SECRET=your_jwt_access_secret_256bit_minimum_cxb_pilot
JWT_REFRESH_SECRET=your_jwt_refresh_secret_256bit_minimum_cxb_pilot
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# -------------------------------------------------------------------------
# Payment gateways — RESERVED: no payment endpoints are implemented yet.
# -------------------------------------------------------------------------
# -------------------------------------------------------------------------
# bKash Payment Gateway Credentials (PGW Tokenized API v1.2.0-beta)
# -------------------------------------------------------------------------
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=sandbox_app_key_cxb_pilot_demo
BKASH_APP_SECRET=sandbox_app_secret_cxb_pilot_demo
BKASH_USERNAME=sandbox_user_cxb
BKASH_PASSWORD=sandbox_pass_cxb
BKASH_CALLBACK_URL=http://localhost:4000/api/v1/payments/bkash/callback
BKASH_TIMEOUT_SECONDS=60

# -------------------------------------------------------------------------
# Nagad PGW Direct / Merchant API Credentials
# -------------------------------------------------------------------------
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_MERCHANT_ID=683002007104225
NAGAD_ACCOUNT_NUMBER=01700000000
NAGAD_MERCHANT_PRIVATE_KEY_PATH=./secrets/nagad_merchant_private.pem
NAGAD_PG_PUBLIC_KEY_PATH=./secrets/nagad_pg_public.pem
NAGAD_CALLBACK_URL=http://localhost:4000/api/v1/payments/nagad/callback

# -------------------------------------------------------------------------
# SMS Gateway for login OTPs (implemented clients: greenweb | bulksmsbd)
# -------------------------------------------------------------------------
# SMS_PROVIDER=none disables delivery. A selected provider needs a real credential,
# or the OTP endpoint fails closed with 503 rather than pretending a code was sent.
# SMS_MOCK_MODE=true simulates dispatch without any network call.
SMS_PROVIDER=none
SMS_MOCK_MODE=true
SMS_MAX_ATTEMPTS=3
SMS_REQUEST_TIMEOUT_MS=10000
SMS_RETRY_BASE_DELAY_MS=500
GREENWEB_API_URL=https://api.greenweb.com.bd/api.php
GREENWEB_API_TOKEN=your_greenweb_api_token_here
GREENWEB_SENDER_ID=CXBEXPRESS
BULKSMSBD_API_URL=https://bulksmsbd.net/api/smsapi
BULKSMSBD_API_KEY=your_bulksmsbd_api_key
BULKSMSBD_SENDER_ID=CXBEXPRESS
SMS_OTP_EXPIRY_MINUTES=5

# The shared secret the SMS gateway presents when it reports what happened to a message
# once it left (src/http/routes/webhookRoutes.ts). Point the gateway's delivery-report
# callback at:
#   POST {PUBLIC_API_URL}/api/v1/webhooks/sms-delivery-reports
# and give it this value as the `x-webhook-secret` header. A bearer token, an `x-api-key`
# header or a `?secret=` query parameter are accepted as well, because gateways differ in
# what they can be configured to send; a GET callback carrying query parameters works as
# well as a POST with a JSON body.
# Empty — the default — means the endpoint answers 403 and ingests nothing: a deployment
# with no secret has nothing to check a report against. The send trail still records every
# attempt, so the OTP flow is unaffected; the platform simply keeps saying "accepted"
# rather than "delivered".
SMS_RECEIPT_WEBHOOK_SECRET=

# -------------------------------------------------------------------------
# Geolocation, OpenStreetMap / OSRM Routing — RESERVED (not read by the runtime)
# -------------------------------------------------------------------------
OSRM_ROUTING_ENGINE_URL=https://router.project-osrm.org/route/v1/driving
NOMINATIM_GEOCODING_URL=https://nominatim.openstreetmap.org
COX_BAZAR_CENTER_LAT=21.4272
COX_BAZAR_CENTER_LNG=92.0058
DEFAULT_SEARCH_RADIUS_KM=12.5

# -------------------------------------------------------------------------
# Dispatch & Surge Pricing — RESERVED: fares come from src/services/pricingService.ts.
# -------------------------------------------------------------------------
DRIVER_DISPATCH_TIMEOUT_SECONDS=45
DRIVER_MAX_ASSIGNMENT_DISTANCE_KM=5.0
DRIVER_MAX_ACTIVE_BATCHED_ORDERS=2
DEFAULT_DELIVERY_BASE_FARE_BDT=40
DEFAULT_DELIVERY_PER_KM_FARE_BDT=15
DEFAULT_PLATFORM_COMMISSION_PERCENT=10

# -------------------------------------------------------------------------
# Operational Logging, Rate Limiting & Monitoring
# -------------------------------------------------------------------------
# Requests allowed per client address per window. Counted in the database, so every
# process serving the same clients shares one budget instead of repeating it, and keyed
# by a digest of the address rather than the address itself (src/http/rateLimiter.ts).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Which peers may be believed about the client's address, and therefore whether
# X-Forwarded-For is read at all (src/http/clientIp.ts).
#   (empty)                      no proxy: the socket address is used, the header is ignored
#   loopback                     a proxy on this host (127.0.0.0/8, ::1)
#   loopback,10.0.0.0/8          addresses and CIDR ranges that append to the header
#   true | all | *               believe any peer (only where nothing untrusted can reach us)
# Behind a proxy this must be set: left empty, every customer shares one rate-limit bucket
# and every session row records the proxy instead of the person. A value that does not parse
# stops the boot rather than falling back to either extreme.
TRUST_PROXY=

# Which forwarded header the proxies in front of this API maintain (src/http/clientIp.ts).
# It is declared, never guessed: reading a header the proxies do not maintain would let
# any caller name itself.
#   x-forwarded-for  the default: X-Forwarded-For, and RFC 7239 Forwarded is ignored
#   forwarded        RFC 7239 Forwarded only (for=, proto=, host=)
#   both             read both; when they name different clients, believe neither and
#                    attribute the request to the proxy
TRUSTED_FORWARD_HEADER=x-forwarded-for

# How many days the address a client connected from — and the device string recorded
# with it — may be kept in auth_sessions, audit_logs and otp_deliveries before it is
# replaced by '[redacted]' (src/auth/clientAddressRetention.ts). The rows themselves
# are kept: a session, an audit entry and an SMS attempt stay as evidence of what
# happened, minus who it was. 0 is refused rather than guessed at, because a privacy
# control that silently does nothing is worse than one that complains.
PII_RETENTION_DAYS=90

# --- RESERVED (not read by the runtime) ---
# The logger writes every level to stdout today, and the API sends no CORS headers at all.
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
ENABLE_SWAGGER_DOCS=true
