# =====================================================================
# PRODUCTION environment template — Cox's Bazar Door2Door backend
# Usage:
#   cp .env.production.example .env.production   # never commit the copy
#   # fill every CHANGE_ME value, then:
#   npm run check:prod [-- --env-file=.env.production]
# src/config/env.ts is the authority; assertSecureProductionConfig()
# refuses to boot when a placeholder or unsafe value remains.
# =====================================================================

NODE_ENV=production
PORT=4000
HOST=0.0.0.0
APP_NAME=CoxBazarDoor2Door

# --- Database: Postgres is required for any multi-process/host deploy ---
DB_DRIVER=postgres
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/cxb_delivery_db
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=10000
# SQLITE_STORAGE_PATH is ignored when DB_DRIVER=postgres.
SQLITE_STORAGE_PATH=./data/cxb_delivery.sqlite

# --- Auth secrets: must both be replaced (boot refuses the dev defaults) ---
# min 16 chars
JWT_SECRET=CHANGE_ME__at_least_16_chars__use_openssl_rand_hex_32
# min 32 chars; rotating invalidates outstanding OTP codes (they must be re-requested)
ENCRYPTION_KEY=CHANGE_ME__at_least_32_chars__use_openssl_rand_hex_32

# --- SMS OTP: mock OFF, one real provider with a real credential ---
SMS_PROVIDER=greenweb
SMS_MOCK_MODE=false
SMS_MAX_ATTEMPTS=3
SMS_REQUEST_TIMEOUT_MS=10000
SMS_RETRY_BASE_DELAY_MS=500
GREENWEB_API_URL=https://api.greenweb.com.bd/api.php
GREENWEB_API_TOKEN=CHANGE_ME__greenweb_token
GREENWEB_SENDER_ID=CXBEXPRESS
BULKSMSBD_API_URL=https://bulksmsbd.net/api/smsapi
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=CXBEXPRESS
# Shared secret the gateway presents on delivery-report callbacks.
# Empty = /webhooks/sms-delivery-reports answers 403 (OTP flow still works).
SMS_RECEIPT_WEBHOOK_SECRET=CHANGE_ME__random_webhook_secret

# --- Proxy: set to match the reverse proxy in front of the API ---
# Empty = no proxy (socket address used, forwarded headers ignored).
# Behind nginx on the same host use: loopback
TRUST_PROXY=loopback
TRUSTED_FORWARD_HEADER=x-forwarded-for

# --- Abuse control & privacy ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Days client IPs / user-agents are kept before '[redacted]'; 1-3650.
PII_RETENTION_DAYS=90
